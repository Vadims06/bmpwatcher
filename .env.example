# configure.sh writes .env from the watcher registration in Topolograph; this
# file shows the same variables for a manual setup.

# Collector image tag; must match the VERSION file of this checkout.
WATCHER_VERSION=v1.2.0
# Prefix for every image when Docker Hub is reached through a mirror, e.g. mirror.example.com:5000/
REGISTRY_PREFIX=

# Topolograph the collector reports to. Port 443 means https, any other port http.
# Your own Topolograph: the Docker host's IP (not localhost), port 8080.
TOPOLOGRAPH_HOST=<host-ip>
TOPOLOGRAPH_PORT=8080
# Token of a BMP watcher added on the Topolograph Monitoring page. The collector
# refuses to start without it; name and source id come from that registration.
TOPOLOGRAPH_API_TOKEN=

BMP_PORT=11019
