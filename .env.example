CONTAINER_NAME=bmp-fluentbit

# Parent directory holding one subdirectory per collector (named after its
# --source-id), each with an artifacts/events.jsonl (bmpwatcher's --events output).
BMPWATCHER_LOG_DIR=/var/log/bmpwatcher

# Topolograph for both the snapshot (collector -> /api/watcher/bgp) and the
# event stream (Fluent Bit -> /api/watcher/bgp/events).
# Your own Topolograph: the Docker host's IP (not localhost), port 8080, TLS off.
# topolograph.com: TOPOLOGRAPH_HOST=topolograph.com, TOPOLOGRAPH_PORT=443, WEBHOOK_TLS_ON=on.
TOPOLOGRAPH_HOST=<host-ip>
TOPOLOGRAPH_PORT=8080
WEBHOOK_TLS_ON=off
# Bearer token (API -> Token -> Create Token). The endpoints answer 401 without it.
TOPOLOGRAPH_API_TOKEN=sk-...

# --- collector (docker compose --profile collector) ---
BMP_PORT=11019
SOURCE_ID=pe1
WATCHER_NAME=bmp-dc1

# --- gobmp (docker compose --profile gobmp) ---
GOBMP_PORT=5000
